# === Секрети: ключі та згенеровані сертифікати ===
# Сертифікати створюються локально скриптом generate_certs і в репозиторій
# не потрапляють: закриті ключі не можна публікувати.
certs/*
!certs/.gitkeep

# === Результати збірки ===
/bin/
/dist/
*.exe
*.test
*.out
*.prof

# === Локальні артефакти роботи програми ===
/tmp/
*.eml
incident_report.log

# === Середовище та секрети ===
.env
.env.*
*.pem

# === Редактори та ОС ===
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
